# Copy to .env and replace the public key with your local Supabase value.
# Get local connection details with: supabase status
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your-local-supabase-publishable-key

# Comma-separated platform root domains; localhost development is supported.
VITE_PLATFORM_ROOT_DOMAIN=serveos.net

# Keep service-role keys, Gemini keys, and worker secrets out of VITE_ variables.
# Server settings belong in supabase/functions/.env.local or hosted secrets.
