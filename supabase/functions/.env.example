# Server-only settings. Copy to supabase/functions/.env.local (gitignored).
# Never use a VITE_ prefix for an API secret.
GEMINI_API_KEY=
GEMINI_SUPPORT_MODEL=gemini-3.8-flash
# Dedicated token shared by the automatic worker and database Vault dispatcher.
# Local setup: node scripts/configure-local-support-ai.mjs
SUPPORT_AI_WORKER_SECRET=
